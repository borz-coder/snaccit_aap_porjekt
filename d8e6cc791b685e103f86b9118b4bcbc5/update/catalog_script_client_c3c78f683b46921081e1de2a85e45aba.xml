        <script><![CDATA[function onLoad() {
    setAvailableColors();
}

function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }
    setAvailableColors();
}

function setAvailableColors() {
    var phone_memory_size = ['128', '256', '512', '1024'];
	// Clear existing choices    
    g_form.clearOptions('phone_memory_size');
    // Add filtered choices    
    phone_memory_size.forEach(function(memory) {
        g_form.addOption('phone_memory_size', memory, memory + ' GB');
    });
}]]></script>
