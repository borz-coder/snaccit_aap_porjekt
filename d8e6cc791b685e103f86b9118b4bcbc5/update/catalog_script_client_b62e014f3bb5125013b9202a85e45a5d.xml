        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   //Type appropriate comment here, and begin script below
    // Aktualisiere den Wert der ersten Variable
    var category = g_form.getValue('model_category');

    // Setze die Reference-Variable neu, um den Filter zu aktualisieren
    g_form.setValue('model', ''); // Lösche den aktuellen Wert der Reference-Variable, falls vorhanden

    // Überprüfe, ob die Kategorie gesetzt ist
    if (category) {
        // Setze den dynamischen Filter für die Reference-Variable
        g_form.setDependentField('model', 'model_category', category);
    } else {
        // Wenn kein Wert gesetzt ist, entferne den Filter
        g_form.setDependentField('model', 'model_category', '');
    }
}]]></script>
